# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend. In production this can be the same origin if the backend
# serves the built frontend files (default). If you run them separately, set
# this to the frontend's public URL.
FRONTEND_ORIGIN=http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite file. The directory will be created automatically.
# Use an absolute path in production to avoid ambiguity.
DATABASE_PATH=./data/stock-control.sqlite

# ── Frontend (only needed for `npm run dev` inside /frontend) ────────────────
# During development Vite proxies /api to the backend. In production the
# backend serves the built frontend, so this variable is not used.
VITE_API_BASE_URL=http://localhost:3001/api
VITE_BACKEND_PORT=3001
