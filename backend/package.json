{
  "name": "stock-control-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the stock control application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/smoke.test.js",
    "check": "node --check server.js && node --check src/db/init.js && node --check src/routes/index.js",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/reset-db.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
