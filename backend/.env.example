# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-before-production

# ── Jira Integration (optional) ───────────────────────────────────────────────
# Set JIRA_ENABLED=true and fill in the credentials to activate.
JIRA_ENABLED=false
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token-here
JIRA_PROJECT_KEY=OPS
# Name of the Jira transition to trigger when a PO is fully received.
# Leave blank to skip automatic status transitions.
JIRA_PO_RECEIVED_TRANSITION=
